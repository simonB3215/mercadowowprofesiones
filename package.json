{
  "name": "mercado-wow-profesiones",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web de rentabilidad de crafteo de World of Warcraft con precios públicos de TSM y catálogo de Blizzard.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env scripts/dev-server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env scripts/dev-server.ts",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "sync:prices": "tsx --env-file-if-exists=.env scripts/sync-prices.ts",
    "sync:catalog": "tsx --env-file-if-exists=.env scripts/sync-catalog.ts",
    "probe:blizzard": "tsx --env-file-if-exists=.env scripts/probe-blizzard.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sync:icons": "tsx --env-file-if-exists=.env scripts/sync-icons.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "csv-parse": "^5.6.0",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "supabase": "^2.122.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
