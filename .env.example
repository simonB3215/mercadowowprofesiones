# Copia este archivo como .env (local) o configura las variables en Vercel → Settings → Environment Variables.
# Nunca subas .env al repositorio.

# --- Base de datos (Supabase / PostgreSQL) ---------------------------------
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543).
# Ejemplo: postgresql://postgres.<ref>:<contraseña>@aws-0-<región>.pooler.supabase.com:6543/postgres
# Si se deja vacío en local, se usa PostgreSQL embebido (PGlite) en ./data/pglite.

DATABASE_URL=
DATABASE_POOL_MAX=5

# --- Supabase Storage (opcional: conserva los CSV originales de TSM) ---------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RAW_BUCKET=tsm-raw

# --- Blizzard Battle.net API (catálogo de profesiones, recetas y objetos) ---
# Crear cliente en https://community.developer.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# --- Acceso -----------------------------------------------------------------
# Contraseña compartida para entrar en la web. Obligatoria en Vercel; si se deja vacía, la API queda abierta.
# Usa al menos 12 caracteres. Al cambiarla se cierran todas las sesiones.
APP_PASSWORD=

# --- Vercel Cron ------------------------------------------------------------
# Vercel envía "Authorization: Bearer <CRON_SECRET>" a /api/cron/sync-prices.
CRON_SECRET=

# --- Otros ------------------------------------------------------------------
# true para ocultar el modo de demostración con datos ficticios.
DISABLE_DEMO=false
# Puerto de la API local (npm run dev).
API_PORT=8787
