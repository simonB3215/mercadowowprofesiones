# Copia este archivo como .env (local) o configura las variables en Vercel → Settings → Environment Variables.
# Nunca subas .env al repositorio.

# --- Base de datos (Supabase / PostgreSQL) ---------------------------------
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543).
# Ejemplo: postgresql://postgres.<ref>:<contraseña>@aws-0-<región>.pooler.supabase.com:6543/postgres
# Si se deja vacío en local, se usa PostgreSQL embebido (PGlite) en ./data/pglite.

DATABASE_URL=
DATABASE_POOL_MAX=5

# --- Supabase Storage (opcional: conserva los CSV originales de TSM) ---------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RAW_BUCKET=tsm-raw

# --- Blizzard Battle.net API (catálogo de profesiones, recetas y objetos) ---
# Crear cliente en https://community.developer.battle.net/access/clients (se usa el namespace static-forever-us)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# --- Conexión con Battle.net («Mi personaje», PC-02) -------------------------
# Usa el mismo cliente de arriba. En https://community.developer.battle.net/access/clients añade como
# «Redirect URLs» EXACTAMENTE (sin barra final):
#   https://mercadowowprofesiones.vercel.app/api/auth/battlenet/callback   (producción)
#   http://localhost:5173/api/auth/battlenet/callback                      (desarrollo: npm run dev)
# Opcionales:
# BNET_TOKEN_KEY: clave para cifrar los tokens de usuario (32 o más caracteres aleatorios). Si falta, se deriva de
#   BLIZZARD_CLIENT_SECRET; si cambia, las sesiones guardadas dejan de valer y hay que volver a conectar.
# BNET_REDIRECT_URI: fuerza la URL de retorno (si no, se deduce del dominio de la petición).
# BNET_PROFILE_NAMESPACES: namespaces de perfil a probar, separados por comas ({region} = us, eu…).
#   Forever no está documentado; por defecto profile-forever-{region}.
BNET_TOKEN_KEY=
BNET_REDIRECT_URI=
BNET_PROFILE_NAMESPACES=

# --- Acceso -----------------------------------------------------------------
# Contraseña compartida para entrar en la web. Obligatoria en Vercel; si se deja vacía, la API queda abierta.
# Usa al menos 12 caracteres. Al cambiarla se cierran todas las sesiones.
APP_PASSWORD=

# --- Vercel Cron ------------------------------------------------------------
# Vercel envía "Authorization: Bearer <CRON_SECRET>" a /api/cron/sync-prices.
CRON_SECRET=

# --- Otros ------------------------------------------------------------------
# Puerto de la API local (npm run dev).
API_PORT=8787
